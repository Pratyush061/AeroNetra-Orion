# AeroNetra-Orion environment configuration (copy to .env)
# Root directory that holds any downloaded datasets (event and aerial).
ORION_DATA_ROOT=./data
# Directory for rendered outputs (videos, annotated frames, metrics).
ORION_OUTPUT_DIR=./outputs
# Optional: path to an exported YOLOv8 ONNX detector to enable learned detection.
ORION_ONNX_MODEL=
